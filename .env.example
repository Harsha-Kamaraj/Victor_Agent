# Victor Agent configuration.
# Copy to .env and fill in. Every key below has a free tier; none require a card.

# --- API keys -------------------------------------------------------------

# Text reasoning, speech-to-text, vision fallback.  https://console.groq.com/keys
GROQ_API_KEY=

# Primary vision.  https://aistudio.google.com/apikey
GEMINI_API_KEY=

# P7 Scout only - reads public repo metadata. A classic token with no scopes is
# enough; it exists purely to lift the unauthenticated rate limit.
GITHUB_TOKEN=

# --- Behaviour ------------------------------------------------------------

# Where quota ledger, traces, action journal and memory index live.
# Defaults to ~/.victor
VICTOR_DATA_DIR=

# DEBUG | INFO | WARNING | ERROR
VICTOR_LOG_LEVEL=INFO

# Never execute actions, only print what would happen. Same as passing --dry-run.
VICTOR_DRY_RUN=false

# Require spoken/typed confirmation before destructive actions. Turning this off
# is not recommended and P3 will warn loudly about it.
VICTOR_CONFIRM_DESTRUCTIVE=true

# Refuse to make a paid-tier call if a provider's free allowance is spent,
# instead of falling through to billing. Keeps the "$0" promise honest.
VICTOR_STRICT_FREE_TIER=true

# --- Model overrides (optional) -------------------------------------------
# Leave blank to use the routing table in src/victor/providers/registry.py

VICTOR_TEXT_MODEL=
VICTOR_VISION_MODEL=
VICTOR_STT_MODEL=
