# Copy to .env and fill in. .env is git-ignored — never commit real keys.
# All three are free tiers, no credit card required.

# Groq — console.groq.com/keys
# Carries text reasoning (ReAct loop) AND speech-to-text, on separate quota pools.
GROQ_API_KEY=

# Google AI Studio — aistudio.google.com/apikey
# Vision only. This is the scarcest resource in the whole system (~250 req/day),
# so the architecture spends it last. Check your real limits at:
#   https://aistudio.google.com/rate-limit
# Not yet used: the vision client lands in P4. Leaving it blank costs nothing today.
GEMINI_API_KEY=

# GitHub personal access token (classic) — scopes: public_repo, read:user
# Used by `victor scout` for portfolio gap analysis. Not yet used: Scout is P7.
GITHUB_TOKEN=


# --- behaviour (defaults live in src/victor/config.py) ---

# Where the quota ledger, traces, action journal and memory index live.
# Defaults to ~/.victor
VICTOR_DATA_DIR=

# DEBUG | INFO | WARNING | ERROR
VICTOR_LOG_LEVEL=INFO

# Never execute actions, only print what would happen. Same as passing --dry-run.
VICTOR_DRY_RUN=false

# Require confirmation before destructive actions. Turning this off leaves only
# the irreversible-command denylist between the model and your machine;
# `victor doctor` warns about it.
VICTOR_CONFIRM_DESTRUCTIVE=true

# Refuse to make a paid-tier call once a provider's free allowance is spent,
# instead of falling through to billing. Keeps the "$0" promise honest.
VICTOR_STRICT_FREE_TIER=true


# --- model overrides (optional) ---
# Blank means "use the routing table in src/victor/providers/registry.py".
# Naming a model promotes it to the front of its chain; the rest stay as
# fallbacks, so a pinned model running out of quota still leaves a working agent.

VICTOR_TEXT_MODEL=
VICTOR_VISION_MODEL=
VICTOR_STT_MODEL=


# --- not implemented yet ---
# Listed so the plan and the code agree on names when these land in P8.
# A system-wide hotkey needs an OS-level hook; today Ctrl-C stops a run and
# `victor listen --mode ptt` starts/stops on Enter.
# VICTOR_KILLSWITCH_HOTKEY=ctrl+alt+esc
# VICTOR_PUSH_TO_TALK_KEY=ctrl+space
