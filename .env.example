# Copy to .env and fill in. .env is git-ignored — never commit real keys.
# All three are free tiers, no credit card required.

# Groq — console.groq.com
# Carries text reasoning (ReAct loop) AND speech-to-text, on separate quota pools.
GROQ_API_KEY=

# Google AI Studio — aistudio.google.com
# Vision only. This is the scarcest resource in the whole system (~250 req/day),
# so the architecture spends it last. Check your real limits at:
#   https://aistudio.google.com/rate-limit
GEMINI_API_KEY=

# GitHub personal access token (classic) — scopes: public_repo, read:user
# Used by `victor scout` for portfolio gap analysis.
GITHUB_TOKEN=

# --- optional overrides (defaults live in victor/config.py) ---
# VICTOR_KILLSWITCH_HOTKEY=ctrl+alt+esc
# VICTOR_PUSH_TO_TALK_KEY=ctrl+space
# VICTOR_TEXT_MODEL=openai/gpt-oss-120b
# VICTOR_STT_MODEL=whisper-large-v3-turbo
# VICTOR_VISION_MODEL=gemini-2.5-flash
